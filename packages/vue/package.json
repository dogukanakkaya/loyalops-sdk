{
    "name": "@loyalops/vue",
    "version": "0.1.0-beta.3",
    "description": "Vue 3 SDK for LoyalOps loyalty programs",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist",
        "publish:package": "npm run build && npm publish --access public --tag=latest"
    },
    "peerDependencies": {
        "vue": ">=3.3.0"
    },
    "dependencies": {
        "@tanstack/vue-query": "^5.90.0"
    },
    "devDependencies": {
        "@loyalops/web-core": "^0.1.0-beta.3",
        "@vue/tsconfig": "^0.5.0",
        "tsup": "^8.5.1",
        "typescript": "^5.7.0",
        "vue": "^3.5.0"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/loyalops-sdk/vue"
    },
    "keywords": [
        "loyalty",
        "missions",
        "rewards",
        "vue",
        "vue3",
        "sdk",
        "embed"
    ]
}
