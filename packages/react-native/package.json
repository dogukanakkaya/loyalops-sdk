{
    "name": "@loyalops/react-native",
    "version": "0.1.0-beta.1",
    "description": "React Native SDK for LoyalOps loyalty programs",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist",
        "publish:package": "npm run build && npm publish --access public --tag=latest"
    },
    "peerDependencies": {
        "react": ">=18.0.0"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.90.21"
    },
    "devDependencies": {
        "@loyalops/react": "^0.1.0-beta.1",
        "@types/react": "^19.0.0",
        "react": "^19.0.0",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/loyalops-sdk/react-native"
    },
    "keywords": [
        "loyalops",
        "loyalty",
        "react-native",
        "sdk"
    ]
}